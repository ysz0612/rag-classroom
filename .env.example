# 이 파일을 .env로 복사한 뒤 실제 값을 입력하세요.
# .env는 Git에 올라가지 않습니다.

POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=change-this-postgres-password

NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-neo4j-password

REDIS_DB=0

JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_EXPIRE_SECONDS=3600

# 상품 번역·임베딩 초기화와 음성/LLM API에 사용됩니다.
OPENAI_API_KEY=

# 쉼표로 구분합니다. Nginx를 통한 동일 출처 접근은 별도 CORS가 필요 없습니다.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8088

